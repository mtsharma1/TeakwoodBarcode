<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Teakwood.Barcode</RootNamespace>
    <StartupObject>Teakwood.Barcode.Program</StartupObject>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TeakwoodBarcode</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="MainForm.vb" />
    <Compile Update="MainForm.Designer.vb"><DependentUpon>MainForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.vb</DependentUpon></EmbeddedResource>
    <Compile Update="DetailsForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="DetailsForm.Designer.vb"><DependentUpon>DetailsForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="DetailsForm.resx"><DependentUpon>DetailsForm.vb</DependentUpon></EmbeddedResource>
    <Compile Update="BatchPreviewForm.vb"><SubType>Form</SubType></Compile>
    <Compile Update="BatchPreviewForm.Designer.vb"><DependentUpon>BatchPreviewForm.vb</DependentUpon></Compile>
    <EmbeddedResource Update="BatchPreviewForm.resx"><DependentUpon>BatchPreviewForm.vb</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
